# ==============================================================================
# NOVA AI Assistant — Backend Environment Configuration
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=development

# Restricted CORS (Allowed Frontend Origin)
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
# Defaults to local MySQL instance on standard port 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nova_db
DB_CONNECTION_LIMIT=10

# Single-Owner Authentication (Local Development)
OWNER_USERNAME=nova_owner
OWNER_PASSWORD=nova_local_2026
OWNER_API_KEY=nova_dev_api_key_8f1c4e92
JWT_SECRET=nova_jwt_secret_key_development_only_change_in_production

# Stage 2: AI Model Provider & Structured Action Engine
# Providers: 'gemini' | 'openai' | 'local'
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-1.5-flash
MODEL_TIMEOUT_MS=25000
MAX_CONTEXT_MESSAGES=12
USAGE_LIMIT_MAX_REQUESTS_PER_MINUTE=30

# Stage 4: Local Automation Agent (Windows)
AUTOMATION_AGENT_URL=http://127.0.0.1:3002
AUTOMATION_AGENT_SECRET=nova_agent_pairing_secret_99a8b7c6
AUTOMATION_TIMEOUT_MS=15000

# Stage 5: Home Assistant Connector
HASS_BASE_URL=
HASS_TOKEN=
HASS_TIMEOUT_MS=10000

# Stage 6: Personal Knowledge & Reusable Workflows
DOCUMENTS_DIR=./data/documents
MAX_DOCUMENT_SIZE_MB=25
MAX_CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
