{
  "name": "nova-ai-assistant",
  "version": "1.0.0",
  "description": "NOVA — Personal 3D AI Assistant Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "node tests/smoke-test.js",
    "agent:start": "node agent/src/server.js",
    "agent:test": "node agent/tests/agent.test.js && node agent/tests/android.test.js",
    "backend:start": "npm start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:migrate": "npm run db:migrate --prefix backend",
    "backend:test": "npm run test:all --prefix backend",
    "test:all": "npm run agent:test && npm run test:all --prefix backend && npm run test:smoke"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}

